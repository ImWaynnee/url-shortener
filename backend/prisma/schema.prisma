datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

model UserAuthProvider {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @db.Uuid @map("user_id")
  user              User      @relation("UserAuthProviders", fields: [userId], references: [id]) 
  provider          String    @map("provider")
  providerUserId    String?   @map("provider_user_id")
  secret            String?   @map("secret")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  @@unique([provider, providerUserId], name: "uq_provider_provider_user_id")
  @@index([userId], name: "idx_user_auth_providers_user_id")
  @@map("user_auth_providers")
}

model UserRefreshToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid @map("user_id")
  user        User      @relation("UserRefreshTokens", fields: [userId], references: [id])
  tokenHash   String    @unique @map("token_hash")
  deviceInfo  String    @map("device_info")
  ipAddress   String    @map("ip_address")
  expiresAt   DateTime  @map("expires_at")
  isRevoked   Boolean   @default(false) @map("is_revoked")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([expiresAt], name: "idx_refresh_tokens_expires_at")
  @@index([isRevoked], name: "idx_refresh_tokens_is_revoked")
  @@index([userId], name: "idx_refresh_tokens_user_id")
  @@map("user_refresh_tokens")
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique
  fullName          String?   @map("full_name")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginProvider String?   @map("last_login_provider")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  createdUrls       Url[]     @relation("UserCreatedUrls")
  authProviders     UserAuthProvider[] @relation("UserAuthProviders")
  refreshTokens     UserRefreshToken[] @relation("UserRefreshTokens")

  @@map("users")
}

model Url {
  id            BigInt    @id @default(autoincrement())
  shortUrl      String    @unique @db.VarChar(7) @map("short_url")
  originalUrl   String    @map("original_url")
  createdById   String    @db.Uuid @map("created_by") @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid"))
  createdBy     User      @relation("UserCreatedUrls", fields: [createdById], references: [id])
  comments      String?   @map("comments")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  @@index([createdById], name: "idx_urls_created_by")
  @@map("urls")
}
