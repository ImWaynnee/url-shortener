FROM node:22.15-alpine3.20 AS builder

RUN apk update && apk upgrade --no-cache
RUN npm install -g pnpm

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY backend/package.json backend/prisma.config.ts ./backend/
COPY backend/prisma ./backend/prisma

RUN pnpm install --filter backend... --frozen-lockfile

RUN cd backend && npx prisma generate --schema prisma/schema.prisma

COPY backend/src ./backend/src
COPY backend/tsconfig.json backend/tsconfig.build.json backend/nest-cli.json ./backend/

RUN pnpm --filter backend build:prod

FROM node:22.15-alpine3.20

RUN apk update && apk upgrade --no-cache
RUN npm install -g pnpm

WORKDIR /app

# Copy workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY backend/package.json backend/prisma.config.ts ./backend/
COPY backend/prisma ./backend/prisma

# Copy node_modules from builder and prune to production-only
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/backend/node_modules ./backend/node_modules
RUN pnpm prune --prod

# Copy build artifacts from the builder stage
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/src/generated ./backend/src/generated

COPY backend/docker/docker-entrypoint.prod.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /app/backend

ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "dist/main"]
