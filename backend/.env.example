# Use 'postgres' hostname when running inside Docker, 'localhost' when running natively
DATABASE_URL=postgresql://urlshortener_user:example@postgres:5432/urlshortener
REDIS_URL=redis://default:example@redis:6379
FRONTEND_URL=http://localhost:7777
REDIRECT_DOMAIN=http://s.localtest.me  # must match NGINX_REDIRECT_HOST in root .env
PORT=3000
