# Docker Compose top-level variables (used by docker-compose.yml, not injected into containers)
# Copy to .env and set your local dev hostnames.

# Subdomain for the API, no protocol here
NGINX_API_HOST=sh-api-local.wyzwyz.xyz

# Subdomain for short-link redirects, no protocol here
NGINX_REDIRECT_HOST=s-local.wyzwyz.xyz

# Credentials
POSTGRES_USER=urlshortener_user
POSTGRES_PASSWORD=example
REDIS_PASSWORD=example

# Host port bindings
BACKEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
PRISMA_STUDIO_PORT=5555