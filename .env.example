# Docker Compose top-level variables (used by docker-compose.yml, not injected into containers)
# Copy to .env and set your local dev hostnames.

# Subdomain for the API
NGINX_API_HOST=http://sh-api-dev.wyzwyz.xyz

# Subdomain for short-link redirects
NGINX_REDIRECT_HOST=http://sh-dev.wyzwyz.xyz

# Host port bindings
BACKEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
PRISMA_STUDIO_PORT=5555