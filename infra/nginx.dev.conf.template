# Local dev Nginx config: server_name values are injected from Docker Compose environment.
# sh-api.wyzwyz.xyz  → NestJS API  (POST /urls/shorten, GET /ping, etc.)
# sh.wyzwyz.xyz    → NestJS redirects (GET /:shortUrl)

server {
    listen 80;
    server_name ${NGINX_API_HOST};

    location / {
        proxy_pass         http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name ${NGINX_REDIRECT_HOST};

    location ~* "^/[A-Za-z0-9_-]{7}\+?$" {
        proxy_pass         http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_intercept_errors on;
        error_page 404 = @missing_link;
    }

    location @missing_link {
        return 302 ${NGINX_FRONTEND_HOST}/missing-link;
    }

    location / {
        return 302 ${NGINX_FRONTEND_HOST}/missing-link;
    }
}